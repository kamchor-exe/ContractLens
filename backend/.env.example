# ─── LLM Provider ─────────────────────────────────────────────
# Cloud provider for extraction and Q&A (default: Claude via Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_PROVIDER=claude          # Options: claude | local

# ─── Embedding Provider ───────────────────────────────────────
# Used to embed contract chunks and user questions for RAG
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_PROVIDER=openai    # Options: openai | local

# ─── Database ─────────────────────────────────────────────────
# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://contractlens:contractlens@localhost:5432/contractlens

# ─── File Storage ─────────────────────────────────────────────
# Local directory where uploaded PDFs are saved (relative to backend/)
STORAGE_PATH=./storage

# ─── CORS ─────────────────────────────────────────────────────
# Frontend origin(s) to allow (comma-separated for multiple)
CORS_ORIGINS=http://localhost:3000

# ─── Demo User ────────────────────────────────────────────────
# Seeded at startup — no registration/login in MVP
DEMO_USER_EMAIL=demo@contractlens.ai
DEMO_USER_NAME=Demo User

# ─── App ──────────────────────────────────────────────────────
APP_ENV=development          # development | production
LOG_LEVEL=info
